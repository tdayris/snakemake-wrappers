rule explore_spatial_data_with_sopa:
    input:
        zgroup="results/sopa/{sample_id}/.zgroup",
        segmentation="results/sopa/{sample_id}/.sopa_cache/tissue_boundaries_done",
        cellpose="results/sopa/{sample_id}/.sopa_cache/cellpose_boundaries_done",
        aggregation="results/sopa/{sample_id}/.sopa_cache/aggregation",
        cell_types="results/sopa/{sample_id}/tables/obs",
        scanpy_preprocess="results/sopa/{sample_id}/.sopa_cache/scanpy_preprocess",
    output:
        explorer=directory("results/sopa/{sample_id}.explorer"),
    log:
        "logs/explore_preprocessed_segmented_data_with_sopa/{sample_id}.log",
    benchmark:
        "benchmark/explore_preprocessed_segmented_data_with_sopa/{sample_id}.tsv"
    conda:
        "resources/environments/sopa.yaml"
    params:
        extra='--mode "-it" --ram-threshold-gb 20 --pixel-size 0.108 --save-h5ad',
        sdata=lambda wildcards, input: subpath(input.zgroup, parent=True),
    shell:
        "sopa explorer write "
        "{params.extra} "
        "--output-path {output.explorer:q} "
        "{params.sdata:q} "
        "> {log} 2>&1"


