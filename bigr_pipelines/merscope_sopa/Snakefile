rule patchify_image_with_sopa:
    input:
        zgroup="results/sopa/{sample_id}/.zgroup",
        segmentation="results/sopa/{sample_id}/.sopa_cache/tissue_boundaries_done",
    output:
        patches_file="results/sopa/{sample_id}/.sopa_cache/patches_file_image",
        patches=temp(touch("results/sopa/{sample_id}/.sopa_cache/patches")),
    log:
        "logs/patchify_image_with_sopa/{sample_id}.log",
    benchmark:
        "benchmark/patchify_image_with_sopa/{sample_id}.tsv"
    conda:
        "resources/environments/sopa.yaml"
    params:
        extra="--patch-width-pixel 6000 --patch-overlap-pixel 150",
        sdata=lambda wildcards, input: subpath(input.zgroup, parent=True),
    shell:
        "sopa patchify image " "{params.extra} " "{params.sdata:q} " "> {log:q} 2>&1 "


