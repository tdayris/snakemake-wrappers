Bootstrap: docker
From: quay.io/condaforge/miniforge3:26.5.3-0

%labels
    Author thibault.dayris@gustaveroussy.fr
    Version v0.5

%help
    This is a miniforge image with Snakemake and additional plugins installed.

%files
    .condarc    /etc/conda/condarc
    environment.yaml    /opt/environment.yaml
    environment.linux-64.pin.txt    /opt/environment.linux-64.pin.txt

%post
    apt update
    apt upgrade -y
    apt install -y build-essential
    export CONDARC="/etc/conda/condarc"
    echo "${CONDARC}"
    conda config --show-sources
    conda create --strict-channel-priority \
                 --channel "https://prefix.dev/conda-forge" \
                 --channel "https://prefix.dev/bioconda" \
                 --channel "nodefaults" \
                 --yes --name "snakemake" --override-channels \
                 --solver "rattler" --insecure --show-channel-urls \
                 --file "/opt/environment.linux-64.pin.txt"


%runscript
    echo "snakemake-conda-apptainer container: $NOW"
    eval "$(conda 'shell.bash' 'hook')"
    conda activate snakemake
    exec "$@"


%test
    eval "$(conda 'shell.bash' 'hook')"
    conda activate snakemake
    export CONDARC="/etc/conda/condarc"
    echo "${CONDARC}"
    conda config --show-sources
    snakemake --help
    snakemake --version
    conda --version
    apptainer --version
    pip list
    conda list
    which conda
    which apptainer
    which snakemake
