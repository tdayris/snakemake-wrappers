Bootstrap: docker
From: python:3.13.16-slim

%labels
    Version v0.12

%help
    This is a python image with Snakemake and additional plugins installed.

# Let conda dependencies and environment be available
# https://github.com/apptainer/apptainer/releases/download/v1.5.4/apptainer_1.5.4-trixie+_amd64.deb
# https://github.com/apptainer/apptainer/releases/download/v1.5.4/apptainer-suid_1.5.4-trixie+_amd64.deb
# https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh
%files
    .condarc    /etc/conda/condarc
    environment.yaml    /opt/environment.yaml
    environment.linux-64.pin.txt    /opt/environment.linux-64.pin.txt
    Miniforge3-Linux-x86_64.sh  /opt/Miniforge3-Linux-x86_64.sh
    apptainer_1.5.4-trixie+_amd64.deb   /opt/apptainer_1.5.4-trixie+_amd64.deb
    apptainer-suid_1.5.4-trixie+_amd64.deb  /opt/apptainer-suid_1.5.4-trixie+_amd64.deb


%environment
    export CONDARC="/etc/conda/condarc"
    export PATH="/root/miniforge3/bin:${PWD}/.snakemake/pip-deployments/bin:${PATH}"
    export PYTHONPATH="${PYTHONPATH:-}:${PWD}/.snakemake/pip-deployments"
    export LANG=C.UTF-8
    export SHELL="/bin/bash"
    eval "$(/root/miniforge3/bin/conda 'shell.bash' 'hook')"


%post -c /bin/bash
    set -euo 'pipefail'
    # Install apptainer and ensure everything is right
    apt update
    apt upgrade -y
    apt install -y build-essential wget bash bzip2 ca-certificates gnupg2 squashfs-tools git
    apt install -y "/opt/apptainer_1.5.4-trixie+_amd64.deb" "/opt/apptainer-suid_1.5.4-trixie+_amd64.deb"
    apt install --fix-broken
    apt clean
    apt autoremove -y
    # Install conda
    bash "/opt/Miniforge3-Linux-x86_64.sh" -bfc
    eval "$(/root/miniforge3/bin/conda 'shell.bash' 'hook')"
    conda create -n "snakemake" --file /opt/environment.linux-64.pin.txt
    conda clean --all --yes
    export CONDARC="/etc/conda/condarc"
    # Install snakemake in '.snakemake/pip-deployments' for persistance
    python3 -m pip install --root-user-action 'ignore' \
        --target "${PWD}/.snakemake/pip-deployments" \
        'snakemake' \
        'pandas==2.3.3' \
        'snakemake-storage-plugin-gcs==1.1.4' \
        'snakemake-storage-plugin-http==0.3.1' \
        'snakemake-storage-plugin-fs==1.1.3' \
        'snakemake-software-deployment-plugin-conda==0.8.4' \
        'snakemake-software-deployment-plugin-container==0.7.5' \
        'snakemake-executor-plugin-slurm==2.8.0' \
        'snakemake-executor-plugin-googlebatch==0.5.1'
    echo 'eval "$(/root/miniforge3/bin/conda shell.bash hook)"' >> "/etc/bash.bashrc"
    echo '&& conda activate snakemake' >> "/etc/bas.bashrc"
    sed -i 's|^\[|#\[|' "/etc/bash.bashrc"
    cat "/etc/bash.bashrc"
    bash "/etc/bash.bashrc"
    python3 -m pip cache purge
    ln -sfv "/root/miniforge3/bin/conda" "/usr/local/bin/conda"
    ln -sfv "/root/miniforge3/bin/mamba" "/usr/local/bin/mamba"
    rm -fv "/opt/apptainer_1.5.4-trixie+_amd64.deb" \
        "/opt/apptainer-suid_1.5.4-trixie+_amd64.deb" \
        "/opt/Miniforge3-Linux-x86_64.sh"
        

# Ensure all commands will stop on any error
# Ensure conda/snakemake are available in PATH
%runscript
    set -euo 'pipefail'
    echo "snakemake-conda-apptainer container: "
    date
    bash /etc/bash.bashrc
    exec "$@"


# Ensure all commands will stop on any error
# Ensure conda/snakemake are available in PATH
# Test conda/apptainer/snakemake availability
%test
    set -euo 'pipefail'
    bash /etc/bash.bashrc
    echo "${CONDARC}"
    conda config --show-sources
    snakemake --help
    snakemake --version
    conda --version
    apptainer --version
    pip list
    which conda
    which apptainer
    which snakemake
    which bash
    ls -lrth /usr/bin/bash
    ls -lrth /bin/bash
    which sh
    ls -lrth /bin/sh
        
