rule test_dysk:
    input:
        # Optional path to a mounting point to analyse
        ".",
    output:
        "dysk.txt",
    log:
        "test_dysk.log",
    threads: 1
    params:
        extra="",
    wrapper:
        "master/utils/dysk"


