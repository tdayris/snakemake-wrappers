rule bwa_aln:
    input:
        fastq="reads/{sample}.{pair}.fastq",
        idx=multiext("genome", ".amb", ".ann", ".bwt", ".pac", ".sa"),
    output:
        "sai/{sample}.{pair}.sai",
    log:
        "logs/bwa_aln/{sample}.{pair}.log",
    threads: 8
    params:
        extra="",
    wrapper:
        "master/bio/bwa/aln"
