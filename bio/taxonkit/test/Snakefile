rule taxonkit_list_txt:
    input:
        taxdump=multiext(
            "test-taxdump/",
            "taxid.map",
            "nodes.dmp",
            "names.dmp",
            "merged.dmp",
            "delnodes.dmp",
        ),
    output:
        "out/list/{sample}.txt",
    log:
        "logs/list/{sample}.log",
    threads: 2
    params:
        command="list",
        extra="--ids 36846609 --indent '\t' --show-name --show-rank",
    wrapper:
        "master/bio/taxonkit"


