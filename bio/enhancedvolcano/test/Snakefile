        "volcano_rds.svg",
    log:
        "logs/enhanced-volcano/rds.log",
    threads: 1
    params:
        extra="lab='Gene_id', x='ShrinkedFC', y='adjusted_pvalues'",
        # width=7,  # Optional PNG width
        # height=7,  # Optional PNG height
    wrapper:
        "master/bio/enhancedvolcano"
