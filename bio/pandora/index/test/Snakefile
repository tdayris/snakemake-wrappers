rule pandora_index:
    input:
        "{gene}/prg.fa",
    output:
        index="{gene}/prg.fa.k15.w14.idx",
        kmer_prgs=directory("{gene}/kmer_prgs"),
    log:
        "pandora_index/{gene}.log",
    threads: 1
    params:
        options="-v -k 15 -w 14",
    wrapper:
        "master/bio/pandora/index"
