rule genomepy:
    output:
        multiext(
            "{assembly}/{assembly}",
            ".fa",
            ".fa.fai",
            ".fa.sizes",
            ".gaps.bed",
            ".annotation.gtf",
            ".blacklist.bed",
        ),
    log:
        "logs/genomepy_{assembly}.log",
    cache: "omit-software"  # mark as eligible for between workflow caching
    params:
        provider="ucsc",  # optional, defaults to ucsc. Choose from ucsc, ensembl, and ncbi
    wrapper:
        "master/bio/genomepy"
