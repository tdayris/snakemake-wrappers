rule bowtie2_build:
    input:
        ref="genome.fasta",
    output:
        multiext(
            "genome",
            ".1.bt2",
            ".2.bt2",
            ".3.bt2",
            ".4.bt2",
            ".rev.1.bt2",
            ".rev.2.bt2",
        ),
    log:
        "logs/bowtie2_build/build.log",
    threads: 8
    params:
        extra="",  # optional parameters
    wrapper:
        "master/bio/bowtie2/build"


rule bowtie2_build_large:
    input:
        ref="genome.fasta",
    output:
        multiext(
            "genome",
            ".1.bt2l",
            ".2.bt2l",
            ".3.bt2l",
            ".4.bt2l",
            ".rev.1.bt2l",
            ".rev.2.bt2l",
        ),
    log:
        "logs/bowtie2_build/build.log",
    threads: 8
    params:
        extra="--large-index",  # optional parameters
    wrapper:
        "master/bio/bowtie2/build"
