rule pbmm2_index:
    input:
        reference="target/{reference}.fasta",
    output:
        "target/{reference}.mmi",
    log:
        "logs/pbmm2_index/{reference}.log",
    threads: 8
    params:
        preset="CCS",  # SUBREAD, CCS, HIFI, ISOSEQ, UNROLLED
        extra="",  # optional additional args
    wrapper:
        "master/bio/pbmm2/index"
