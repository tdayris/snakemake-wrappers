rule preprocess_variants:
    input:
        ##vcf/bcf
        variants="variants.vcf",
    output:
        "normalized/variants.vcf.gz",
    log:
        "log/pre.log",
    threads: 2
    params:
        ## path to reference genome
        genome="genome.fasta",
        ## parameters such as -L to left-align variants
        extra="-L",
    wrapper:
        "master/bio/hap.py/pre.py"
