rule test_deeptools_multibwsummary_bins:
    input:
        bw=["a.bw", "b.bw"],
        blacklist="blacklist.bed",  # Optional
    output:
        npz="bins.npz",
        counts="bins.counts",
    log:
        "bins.logs",
    threads: 1
    params:
        extra="",
    wrapper:
        "master/bio/deeptools/multibigwigsummary"


rule test_deeptools_multibwsummary_bed:
    input:
        bw=["a.bw", "b.bw"],
        bed="intervals.bed",
        # blacklist="", # Optional
    output:
        npz="bed.npz",
        counts="bed.counts",
    log:
        "bins.logs",
    threads: 1
    params:
        extra="",
    wrapper:
        "master/bio/deeptools/multibigwigsummary"
