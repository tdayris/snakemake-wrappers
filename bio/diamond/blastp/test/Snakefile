rule diamond_blastp:
    input:
        fname_fasta="{sample}.fasta",  # Query fasta file
        fname_db="db.dmnd",  # Diamond db
    output:
        fname="{sample}.tsv.gz",  # Output file
    log:
        "logs/diamond_blastp/{sample}.log",
    threads: 8
    params:
        extra="--header --compress 1",  # Additional arguments
    wrapper:
        "master/bio/diamond/blastp"
