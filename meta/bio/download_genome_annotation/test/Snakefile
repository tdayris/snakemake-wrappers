from snakemake.utils import min_version

min_version("9.13.1")

configfile: "config.yaml"

wildcard_constraints:
    species=r"saccharomyces_cerevisiae",
    build=r"R64-1-1",
    release=r"105",
    gfx=f"gtf|gff3",


rule target:
    input:
        expand(
            "resources/{species}.{build}.{release}/annotations/{species}.{build}.{release}.{gxf}",
            species=["saccharomyces_cerevisiae"],
            build=["R64-1-1"],
            release=[105],
            gxf={"gtf", "gff3"},
        ),


module download_genome_annotation:
    config:
        config
    meta_wrapper:
        "file:.."


use rule * from download_genome_annotation
