from snakemake.utils import min_version

min_version("9.13.1")

container: "docker://quay.io/condaforge/miniforge3:26.5.3-0"

configfile: "config.yaml"

module access_fastq_files_pair:
    config:
        config
    meta_wrapper:
        "file:.."

use rule * from access_fastq_files_pair

rule target:
    input:
        expand(
            "<temp>/fastcat_fastq/{sample}.{stream}.fastq.gz",
            sample=access_fastq_files_pair.samples_table.sample_id,
            stream={1, 2},
        ),
        "<results>/fastq_qc/fastcat_per_fastq_file_qc.csv.gz",
        "<results>/fastq_qc/Material_and_methods_access_fastq_file_pairs.html",
    default_target: True


